      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">middleware</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.Parent.util.libtypes)
local logger = require(script.Parent.Parent.util.logger)

local middleware_map: { [number]: { libtypes.Middleware } } = {}

local function middleware(t: { read id: number }, mw: libtypes.Middleware)
	local entry = middleware_map[t.id] or {}
	table.insert(entry, mw)
	middleware_map[t.id] = entry
end

local function run_middleware(id: number, plr: Player)
	local mw = middleware_map[id]
	if mw then
		for _, v in mw do
			-- a middleware that throws refuses
			local ran, allowed = pcall(v, id, plr)
			if not ran then
				logger.red(`MIDDLEWARE FAILED FOR #{id}: {allowed}`)
				return false
			end
			if not allowed then
				return false
			end
		end
	end
	return true
end

return table.freeze({
	run_middleware = run_middleware,
	middleware = middleware,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">schema</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local ref_tracker = require(script.Parent.Parent.trackers["ref-tracker"])
local libtypes = require(script.Parent.Parent.util.libtypes)
local writer = require(script.Parent.Parent.util.writer)

local b_u8 = writer.u8
local b_f32 = writer.f32
local b_varint = writer.varint
local writestring = writer.writestring

local freeze = table.freeze :: <T>(T) -> T

-- inner schema of every maybe(), so struct can fold the presence byte into its flag bits
local maybe_inner: { [any]: libtypes.Schema<any> } = setmetatable({}, { __mode = "k" }) :: any

local function read_varint(b: buffer, o: number): (number, number)
	local byte = buffer.readu8(b, o)
	if byte < 128 then
		return byte, 1
	end
	local value, scale, n = byte - 128, 128, 1
	repeat
		-- the writer never emits more than 8 bytes; past that the value runs to inf and NaN
		if n == 8 then
			error("VARINT TOO LONG")
		end
		byte = buffer.readu8(b, o + n)
		value += byte % 128 * scale
		scale *= 128
		n += 1
	until byte < 128
	return value, n
end

local function read_len(b: buffer, o: number): (number, number)
	local len, n = buffer.readu8(b, o), 1
	if len >= 128 then
		len, n = read_varint(b, o)
		-- an element costs at least a bit, so a count past that is forged
		if len > buffer.len(b) * 8 then
			error("LENGTH EXCEEDS THE PACKET")
		end
	end
	return len, n
end

-- # picks any border of a table with a hole, so the array would be cut short without a word
local function array_len(v: { any }): number
	local len = #v
	if table.maxn(v) ~= len then
		error(`ARRAY HAS A HOLE: # IS {len} BUT THE LAST INDEX IS {table.maxn(v)}`)
	end
	return len
end

local bool: libtypes.Schema<boolean> = {
	read = function(buf, o)
		return (buffer.readu8(buf, o) == 1), 1
	end,
	write = writer.bool,
	__T = nil :: never,
}

local u8: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readu8(buf, o), 1
	end,
	write = b_u8,
	__T = nil :: never,
}
local u16: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readu16(buf, o), 2
	end,
	write = writer.u16,
	__T = nil :: never,
}
local u32: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readu32(buf, o), 4
	end,
	write = writer.u32,
	__T = nil :: never,
}

local i8: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readi8(buf, o), 1
	end,
	write = writer.i8,
	__T = nil :: never,
}
local i16: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readi16(buf, o), 2
	end,
	write = writer.i16,
	__T = nil :: never,
}
local i32: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readi32(buf, o), 4
	end,
	write = writer.i32,
	__T = nil :: never,
}

-- whole numbers under 2^53, a byte per 7 bits
local uvar: libtypes.Schema<number> = {
	read = read_varint,
	write = b_varint,
	__T = nil :: never,
}
local ivar: libtypes.Schema<number> = {
	read = function(buf, o)
		local z, n = read_varint(buf, o)
		if z % 2 == 0 then
			return z / 2, n
		end
		return -(z + 1) / 2, n
	end,
	write = function(v)
		-- zigzag only maps integers, and doubles them into varint's 2^53 range
		if v // 1 ~= v or v < -2 ^ 52 or v >= 2 ^ 52 then
			error(`IVAR TAKES AN INTEGER FROM -2^52 TO 2^52 - 1, GOT {v}`)
		end
		-- zigzag, so a small negative is as short as a small positive
		b_varint(if v < 0 then -2 * v - 1 else 2 * v)
	end,
	__T = nil :: never,
}

local f32: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readf32(buf, o), 4
	end,
	write = writer.f32,
	__T = nil :: never,
}

local f64: libtypes.Schema<number> = {
	read = function(buf, o)
		return buffer.readf64(buf, o), 8
	end,
	write = writer.f64,
	__T = nil :: never,
}

local function maybe<T>(input: libtypes.Schema<T>): libtypes.Schema<T?>
	local read, write = input.read, input.write
	local schema: libtypes.Schema<T?> = {
		read = function(buf, offset)
			if buffer.readu8(buf, offset) == 0 then
				return nil, 1
			else
				local item, length = read(buf, offset + 1)
				return item, length + 1
			end
		end,
		write = function(v)
			if v == nil then
				b_u8(0)
			else
				b_u8(1)
				write(v)
			end
		end,
		__T = nil :: never,
	}
	maybe_inner[schema] = input
	return schema
end

local bool_array: libtypes.Schema<{ boolean }> = {
	read = function(b, cursor)
		local len, n = read_len(b, cursor)
		local c = cursor + n
		-- no bigger than the rest of the packet can hold, whatever the length claims
		local out = table.create(math.min(len, (buffer.len(b) - c) * 8)) :: { boolean }
		local byte = 0
		for i = 1, len do
			if i % 8 == 1 then
				byte = buffer.readu8(b, c)
				c += 1
			end
			out[i] = byte % 2 == 1
			byte //= 2
		end
		return out, c - cursor
	end,
	write = function(v)
		local len = array_len(v)
		b_varint(len)
		local byte, weight = 0, 1
		for i = 1, len do
			if v[i] then
				byte += weight
			end
			if weight == 128 then
				b_u8(byte)
				byte, weight = 0, 1
			else
				weight *= 2
			end
		end
		if weight ~= 1 then
			b_u8(byte)
		end
	end,
	__T = nil :: never,
}

local function array<T>(input: libtypes.Schema<T>): libtypes.Schema<{ T }>
	if input == bool :: any then
		return bool_array :: any
	end
	local read, write = input.read, input.write
	return {
		read = function(b, cursor)
			local len, n = read_len(b, cursor)
			local arr_cursor = cursor + n
			local out: { T } = table.create(math.min(len, buffer.len(b) - arr_cursor))
			for i = 1, len do
				local v, size = read(b, arr_cursor)
				-- read_len only bounds the length by the packet if every element takes space
				if size == 0 then
					error("ARRAY ELEMENTS MUST TAKE AT LEAST A BYTE")
				end
				out[i] = v
				arr_cursor += size
			end
			return out, arr_cursor - cursor
		end,
		write = function(v)
			local s = array_len(v)
			b_varint(s)
			for i = 1, s do
				write(v[i])
			end
		end,
		__T = nil :: never,
	}
end

local function map<K, V>(k: libtypes.Schema<K>, v: libtypes.Schema<V>): libtypes.Schema<{ [K]: V }>
	local kread, kwrite = k.read, k.write
	local vread, vwrite = v.read, v.write

	return {
		read = function(b, cursor)
			local len, n = read_len(b, cursor)
			local out = {}
			local map_cursor = cursor + n
			for i = 1, len do
				local key, klen = kread(b, map_cursor)
				map_cursor += klen
				local value, vlen = vread(b, map_cursor)
				map_cursor += vlen
				if klen + vlen == 0 then
					error("MAP ENTRIES MUST TAKE AT LEAST A BYTE")
				end
				-- a key that can't index a table (a ref that has not streamed in, NaN) loses its entry
				if key ~= nil and key == key then
					out[key] = value
				end
			end
			return out, map_cursor - cursor
		end,
		write = function(input)
			local count = 0
			for _ in input do
				count += 1
			end
			b_varint(count)
			for key, value in input do
				kwrite(key)
				vwrite(value)
			end
		end,
		__T = nil :: never,
	}
end

local function set<K>(k: libtypes.Schema<K>): libtypes.Schema<{ [K]: boolean }>
	local kread, kwrite = k.read, k.write

	return {
		read = function(b, cursor)
			local len, n = read_len(b, cursor)
			local out = {}
			local set_cursor = cursor + n
			for i = 1, len do
				local key, klen = kread(b, set_cursor)
				set_cursor += klen
				if klen == 0 then
					error("SET KEYS MUST TAKE AT LEAST A BYTE")
				end
				if key ~= nil and key == key then
					out[key] = true
				end
			end
			return out, set_cursor - cursor
		end,
		write = function(input)
			local count = 0
			for _, v in input do
				if v then
					count += 1
				end
			end
			b_varint(count)
			for key, v in input do
				if v then
					kwrite(key)
				end
			end
		end,
		__T = nil :: never,
	}
end

local function struct<T>(input: T & {}): libtypes.Schema<libtypes.GetNestedSchema<T> & {}>
	local names: { string } = {}
	for name in input :: { [string]: any } do
		names[#names + 1] = name
	end
	table.sort(names, function(a0: string, a1: string): boolean
		return a0 > a1
	end)

	-- every bool field and every maybe's presence is one bit in the leading flag bytes
	local flag_names: { string }, flag_maybe: { boolean } = {}, {}
	local bool_names: { string }, bool_offset: { number }, bool_mask: { number } = {}, {}, {}
	local field_names: { string }, field_offset: { number }, field_mask: { number } = {}, {}, {}
	local field_read: { (buffer, number) -> (any, number) }, field_write: { (any) -> () } = {}, {}
	local template: { [string]: any } = {}

	for _, name in names do
		local field: libtypes.Schema<any> = (input :: any)[name]
		local inner = maybe_inner[field]
		local flagged = inner ~= nil or field == bool :: any
		local bit = #flag_names
		template[name] = false

		if flagged then
			flag_names[bit + 1] = name
			flag_maybe[bit + 1] = inner ~= nil
		end
		if flagged and not inner then
			local i = #bool_names + 1
			bool_names[i], bool_offset[i], bool_mask[i] = name, bit // 8, 2 ^ (bit % 8)
		else
			local i = #field_names + 1
			field_names[i] = name
			field_offset[i] = if inner then bit // 8 else 0
			field_mask[i] = if inner then 2 ^ (bit % 8) else 0
			field_read[i] = if inner then inner.read else field.read
			field_write[i] = if inner then inner.write else field.write
		end
	end

	local flag_count, bool_count, field_count = #flag_names, #bool_names, #field_names
	local flag_bytes = (flag_count + 7) // 8

	return {
		read = function(buff, cursor)
			local out = table.clone(template)
			for i = 1, bool_count do
				out[bool_names[i]] = bit32.btest(buffer.readu8(buff, cursor + bool_offset[i]), bool_mask[i])
			end
			local str_cursor = cursor + flag_bytes
			for i = 1, field_count do
				local mask = field_mask[i]
				if mask == 0 or bit32.btest(buffer.readu8(buff, cursor + field_offset[i]), mask) then
					local value, offset = field_read[i](buff, str_cursor)
					out[field_names[i]] = value
					str_cursor += offset
				else
					out[field_names[i]] = nil
				end
			end
			return out :: any, str_cursor - cursor
		end,
		write = function(v)
			local byte, weight = 0, 1
			for i = 1, flag_count do
				local value = (v :: any)[flag_names[i]]
				if value or (value ~= nil and flag_maybe[i]) then
					byte += weight
				end
				if weight == 128 then
					b_u8(byte)
					byte, weight = 0, 1
				else
					weight *= 2
				end
			end
			if weight ~= 1 then
				b_u8(byte)
			end
			for i = 1, field_count do
				local value = (v :: any)[field_names[i]]
				if value ~= nil or field_mask[i] == 0 then
					field_write[i](value)
				end
			end
		end,
		__T = nil :: never,
	}
end

local function vector3<T>(input: libtypes.Schema<T & number>): libtypes.Schema<Vector3>
	local read, write = input.read, input.write
	return {
		read = function(b, o)
			local c = o
			local x, y, z, n
			x, n = read(b, c)
			c += n
			y, n = read(b, c)
			c += n
			z, n = read(b, c)
			c += n
			return Vector3.new(x, y, z), c - o
		end,
		write = function(v: Vector3)
			write(v.X)
			write(v.Y)
			write(v.Z)
		end,
		__T = nil :: never,
	}
end
local function cframe<T>(input: libtypes.Schema<T & number>): libtypes.Schema<CFrame>
	local read, write = input.read, input.write

	return {
		read = function(buff, init)
			local c = init
			local x, y, z, n
			x, n = read(buff, c)
			c += n
			y, n = read(buff, c)
			c += n
			z, n = read(buff, c)
			c += n
			local rx, ry, rz = buffer.readf32(buff, c), buffer.readf32(buff, c + 4), buffer.readf32(buff, c + 8)
			return CFrame.Angles(rx, ry, rz) + Vector3.new(x, y, z), c + 12 - init
		end,
		write = function(v: CFrame)
			local rx, ry, rz = v:ToEulerAnglesXYZ()
			write(v.X)
			write(v.Y)
			write(v.Z)
			-- angles are always f32, T only packs the position: an integer T would round them to whole radians
			b_f32(rx)
			b_f32(ry)
			b_f32(rz)
		end,
		__T = nil :: never,
	}
end

local null: libtypes.Schema<nil> = {
	write = function() end,
	read = function()
		return nil, 0
	end,
	__T = nil,
}

local str: libtypes.Schema<string> = {
	read = function(b, cursor)
		local len, n = buffer.readu8(b, cursor), 1
		if len >= 128 then
			len, n = read_len(b, cursor)
		end
		return buffer.readstring(b, cursor + n, len), n + len
	end,
	write = function(v)
		b_varint(#v)
		writestring(v)
	end,
	__T = nil :: never,
}

local ref: libtypes.Schema<any?> = {
	read = function(b, cursor)
		local ref_list = ref_tracker.get()
		if not ref_list then
			return nil, 1
		end
		-- index 0 is nil, the writer never puts it in the list
		return ref_list[buffer.readu8(b, cursor)], 1
	end,
	write = writer.reference,
	__T = nil :: never,
}

return freeze({
	maybe = maybe,
	array = array,
	struct = struct,
	map = map,
	set = set,
	vector = vector3,
	cframe = cframe,

	-- primitive:
	ref = ref,
	str = str,
	bool = bool,
	null = null,
	u8 = u8,
	u16 = u16,
	u32 = u32,
	i8 = i8,
	i16 = i16,
	i32 = i32,
	uvar = uvar,
	ivar = ivar,
	f32 = f32,
	f64 = f64,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">validate</string>
          <string name="Source"><![CDATA[return @native function(b: buffer, refs: { unknown }?)
	if refs and typeof(refs) ~= "table" then
		return false
	end
	return typeof(b) == "buffer" and buffer.len(b) > 0
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">init-modules</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">client</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local constants = require(script.Parent.Parent.constants)
local connections = require(script.Parent.Parent.trackers.connections)
local ref_tracker = require(script.Parent.Parent.trackers["ref-tracker"])

local channel = require(script.Parent.Parent.util.channel)
local dump = require(script.Parent.Parent.util.dump)
local libtypes = require(script.Parent.Parent.util.libtypes)
local logger = require(script.Parent.Parent.util.logger)
local writer = require(script.Parent.Parent.util.writer)
local iter_and_convert = require(script.Parent.Parent.util["iter-and-convert"])
local read = require(script.Parent.Parent.util.read)
local remote_names = require(script.Parent.Parent.util["remote-names"])
local small_buffer = require(script.Parent.Parent.util["small-buffer"])

local append = channel.append

local __init = false

local function init<T>(t: T & {}): libtypes.ReplicateClient<T>
	assert(not __init, "NETWORKING ALREADY STARTED")

	-- found below; nothing can fire before init returns, so the channels only reach them after that
	local ReliableEvent: RemoteEvent
	local UnreliableEvent: UnreliableRemoteEvent
	local RemoteFunction: RemoteFunction
	-- what the server accepts from one call, read from its remote
	local max_size = constants.MAX_SERVER_BUFFER_SIZE

	local payload_reliable = channel.new(function(b, refs)
		ReliableEvent:FireServer(b, refs)
	end, max_size, true)
	local payload_unreliable = channel.new(function(b, refs)
		UnreliableEvent:FireServer(b, refs)
	end, constants.MAX_UNRELIABLE_SIZE, false)

	local function invoke_fn(
		id: number,
		write: (any) -> (),
		reader: (buffer: buffer, cursor: number) -> (any, number),
		data: any
	): (boolean, any)
		local b = small_buffer()
		writer.message(b, id, write, data)
		local refs = #b.references
		if refs > constants.MAX_REFS then
			-- ref indices are one byte, past MAX_REFS they would point at the wrong refs
			error(`REMOTE #{id} WROTE {refs} REFS, ONE MESSAGE CAN CARRY {constants.MAX_REFS}`)
		end
		if b.cursor > max_size then
			logger.red(`REMOTE #{id} WROTE A {b.cursor}B INVOKE, OVER THE SERVER'S {max_size}B LIMIT`)
			return false, nil
		end
		-- events fired before the call reach the server before it
		channel.flush(payload_reliable)
		local success, nbuf, nrefs = RemoteFunction:InvokeServer(dump(b))
		if success then
			ref_tracker.set(nrefs)
			return true, (reader(nbuf, 0))
		end
		return false, nil
	end

	local function create_object(intermediate: libtypes.Intermediate<any, any>): any
		local id = intermediate.id
		local write = intermediate.schema.write
		if intermediate.__kind == "function" then
			local read_output = (intermediate.schema_output :: libtypes.Schema<any>).read
			local r: libtypes.ClientFunction = table.freeze({
				invoke = function(self, data)
					return invoke_fn(id, write, read_output, data)
				end,
				__kind = "function" :: "function",
				__T = nil :: never,
			})
			return r
		elseif intermediate.__kind == "event" then
			local payload = if intermediate.reliable then payload_reliable else payload_unreliable
			local r: libtypes.ClientRemote = table.freeze({
				connect = function(self, callback)
					return connections.add(id, callback)
				end,
				fire = function(self, data)
					append(payload, id, write, data)
				end,
				__kind = "event" :: "event",
				__T = nil :: never,
			})
			return r
		end
		error("INVALID __KIND! EXPECTED function | event")
	end

	-- before anything waits, so bad definitions throw at once and leave nothing behind
	local converted, signature = iter_and_convert(t, create_object)
	__init = true

	-- the names hang off the JobId, which can be read before it replicates, so they are worked out again each frame
	local reliable_name, unreliable_name, function_name = remote_names.names(game.JobId)
	local waited = 0
	while not constants.EVENT_FOLDER:FindFirstChild(reliable_name) do
		local was = waited
		waited += task.wait()
		if was < 5 and waited >= 5 then
			logger.red(`NO REMOTES FOR JOBID "{game.JobId}" AFTER 5S, IS create_server RUNNING ON THE SERVER?`)
		end
		reliable_name, unreliable_name, function_name = remote_names.names(game.JobId)
	end

	ReliableEvent = constants.EVENT_FOLDER:WaitForChild(reliable_name) :: RemoteEvent
	UnreliableEvent = constants.EVENT_FOLDER:WaitForChild(unreliable_name) :: UnreliableRemoteEvent
	RemoteFunction = constants.EVENT_FOLDER:WaitForChild(function_name) :: RemoteFunction

	max_size = (ReliableEvent:GetAttribute(constants.MAX_SIZE_ATTRIBUTE) :: number?) or max_size
	payload_reliable.limit = max_size
	payload_unreliable.limit = math.min(constants.MAX_UNRELIABLE_SIZE, max_size)
	if ReliableEvent:GetAttribute(constants.SIGNATURE_ATTRIBUTE) ~= signature then
		logger.red(
			"THE SERVER AND THE CLIENT BUILT DIFFERENT REMOTES, SO MESSAGES CAN REACH THE WRONG ONE! CREATE THE SAME REMOTES IN THE SAME ORDER ON BOTH SIDES"
		)
	end

	ReliableEvent.OnClientEvent:Connect(read)
	UnreliableEvent.OnClientEvent:Connect(read)

	RunService.Heartbeat:Connect(channel.flush_all)

	return converted :: never
end

return init
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">server</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local constants = require(script.Parent.Parent.constants)
local validate = require(script.Parent.Parent.features.validate)
local connections = require(script.Parent.Parent.trackers.connections)
local callbacks = require(script.Parent.Parent.util.callbacks)

local channel = require(script.Parent.Parent.util.channel)
local libtypes = require(script.Parent.Parent.util.libtypes)
local logger = require(script.Parent.Parent.util.logger)
local iter_and_convert = require(script.Parent.Parent.util["iter-and-convert"])
local read = require(script.Parent.Parent.util.read)
local read_server_remote_function = require(script.Parent.Parent.util["read-server-remote-function"])
local remote_names = require(script.Parent.Parent.util["remote-names"])

local append = channel.append
local flush = channel.flush

local __init = false

local function init<T>(t: T & {}, max_buffer_size: number?): libtypes.ReplicateServer<T>
	assert(not __init, "NETWORKING ALREADY STARTED")

	local max_size: number = max_buffer_size or constants.MAX_SERVER_BUFFER_SIZE

	local reliable_name, unreliable_name, function_name = remote_names.names(game.JobId)

	local ReliableEvent = Instance.new("RemoteEvent")
	ReliableEvent.Name = reliable_name
	local UnreliableEvent = Instance.new("UnreliableRemoteEvent")
	UnreliableEvent.Name = unreliable_name
	local RemoteFunction = Instance.new("RemoteFunction")
	RemoteFunction.Name = function_name

	local global_reliable = channel.new(function(b, refs)
		ReliableEvent:FireAllClients(b, refs)
	end, math.huge, true)
	local global_unreliable = channel.new(function(b, refs)
		UnreliableEvent:FireAllClients(b, refs)
	end, constants.MAX_UNRELIABLE_SIZE, false)

	-- players that left, so a late fire() does not open a channel nobody closes
	local gone: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any

	local function per_player(fire: (Player, buffer, { unknown }?) -> (), limit: number, reliable: boolean)
		local lanes: { [Player]: libtypes.Channel } = {}
		local function lane_for(player: Player): libtypes.Channel?
			local found = lanes[player]
			-- a Player that left has no parent, which still holds once gone has let go of it
			if not found and player.Parent == Players and not gone[player] then
				found = channel.new(function(b, refs)
					fire(player, b, refs)
				end, limit, reliable)
				lanes[player] = found
			end
			return found
		end
		return lanes, lane_for
	end

	local players_reliable, reliable_for = per_player(function(player, b, refs)
		ReliableEvent:FireClient(player, b, refs)
	end, math.huge, true)
	local players_unreliable, unreliable_for = per_player(function(player, b, refs)
		UnreliableEvent:FireClient(player, b, refs)
	end, constants.MAX_UNRELIABLE_SIZE, false)

	-- fire and fire_all keep one order: a reliable lane is sent early before the other one takes a message,
	-- so only one side ever has messages waiting
	local last_global = false
	local function to_all()
		if not last_global then
			for _, lane in players_reliable do
				flush(lane)
			end
			last_global = true
		end
	end
	local function to_players()
		if last_global then
			flush(global_reliable)
			last_global = false
		end
	end

	local function create_object(intermediate: libtypes.Intermediate<any, any>): any
		local id = intermediate.id
		if intermediate.__kind == "function" then
			local r: libtypes.ServerFunction = table.freeze({
				set_callback = function(self, callback)
					return callbacks.set(id, callback)
				end,
				__kind = "function" :: "function",
				__T = nil :: never,
			})
			return r
		elseif intermediate.__kind == "event" then
			local write = intermediate.schema.write
			local reliable = intermediate.reliable
			local global = if reliable then global_reliable else global_unreliable
			local channel_for: (Player) -> libtypes.Channel? = if reliable then reliable_for else unreliable_for

			local r: libtypes.ServerRemote = table.freeze({
				connect = function(self, callback)
					return connections.add(id, callback)
				end,
				fire_all = function(self, data)
					if reliable then
						to_all()
					end
					append(global, id, write, data)
				end,
				fire = function(self, p, data)
					local target = channel_for(p)
					if target then
						if reliable then
							to_players()
						end
						append(target, id, write, data)
					end
				end,
				__kind = "event" :: "event",
				__T = nil :: never,
			})
			return r
		end
		error("INVALID __KIND! EXPECTED function | event")
	end

	-- before anything is started, so bad definitions leave nothing behind
	local converted, signature = iter_and_convert(t, create_object)
	__init = true

	-- logged, not raised: any client can send anything, as often as it likes
	local function accept(buf: any, ref: any): boolean
		if not validate(buf, ref) then
			logger.orange("DROPPED AN INVALID PACKET")
			return false
		end
		local len = buffer.len(buf)
		if len > max_size then
			logger.orange(
				`BUFFER OF SIZE {len} EXCEEDS {max_size}B! PASS A BIGGER SIZE AS THE SECOND ARGUMENT OF create_server`
			)
			return false
		end
		return true
	end

	local function on_event(player: Player, buf: any, ref: any)
		if accept(buf, ref) then
			read(buf, ref, player)
		end
	end

	UnreliableEvent.OnServerEvent:Connect(on_event)
	ReliableEvent.OnServerEvent:Connect(on_event)

	RemoteFunction.OnServerInvoke = function(plr, b, ref): any
		if not accept(b, ref) then
			return false, nil, nil
		end
		local ok, out, refs = read_server_remote_function(plr, b, ref)
		-- the reply must not overtake events fired to this player before it
		flush(global_reliable)
		local lane = players_reliable[plr]
		if lane then
			flush(lane)
		end
		return ok, out, refs
	end

	Players.PlayerRemoving:Connect(function(player)
		gone[player] = true
		local reliable, unreliable = players_reliable[player], players_unreliable[player]
		if reliable then
			reliable.cursor = 0
			players_reliable[player] = nil
		end
		if unreliable then
			unreliable.cursor = 0
			players_unreliable[player] = nil
		end
	end)

	RunService.Heartbeat:Connect(channel.flush_all)

	-- read by the client: its batches must fit max_size, and its ids must match these
	ReliableEvent:SetAttribute(constants.MAX_SIZE_ATTRIBUTE, max_size)
	ReliableEvent:SetAttribute(constants.SIGNATURE_ATTRIBUTE, signature)

	ReliableEvent.Parent = constants.EVENT_FOLDER
	UnreliableEvent.Parent = constants.EVENT_FOLDER
	RemoteFunction.Parent = constants.EVENT_FOLDER
	return converted :: never
end

return init
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">shared</string>
          <string name="Source"><![CDATA[local schema = require(script.Parent.Parent.features.schema)
local remote_tracker = require(script.Parent.Parent.trackers["remote-tracker"])
local libtypes = require(script.Parent.Parent.util.libtypes)

-- a schema left out is nil, not a T nothing constrains, so a payload given for it is a type error
type Event =
	(<T>(input: libtypes.Schema<T>) -> libtypes.Intermediate<T, nil, "event">)
	& (() -> libtypes.Intermediate<nil, nil, "event">)
type Function =
	(<T, K>(input: libtypes.Schema<T>, output: libtypes.Schema<K>) -> libtypes.Intermediate<T, K, "function">)
	& (<K>(input: nil, output: libtypes.Schema<K>) -> libtypes.Intermediate<nil, K, "function">)
	& (<T>(input: libtypes.Schema<T>) -> libtypes.Intermediate<T, nil, "function">)
	& (() -> libtypes.Intermediate<nil, nil, "function">)

local function event<T>(input: libtypes.Schema<T>?): libtypes.Intermediate<T, nil, "event">
	local t = table.freeze({
		__kind = "event" :: "event",
		__schema = nil :: T,
		__schema_output = nil,
		schema = input or schema.null,
		id = remote_tracker.take(),
		reliable = true,
	})
	remote_tracker.map(t.id, t)
	return t
end

local function unreliable<T>(input: libtypes.Schema<T>?): libtypes.Intermediate<T, nil, "event">
	local t = table.freeze({
		__kind = "event" :: "event",
		__schema = nil :: T,
		__schema_output = nil,
		schema = input or schema.null,
		id = remote_tracker.take(),
		reliable = false,
	})
	remote_tracker.map(t.id, t)
	return t
end

local function fn<T, K>(input: libtypes.Schema<T>?, output: libtypes.Schema<K>?): libtypes.Intermediate<T, K, "function">
	local t = table.freeze({
		__kind = "function" :: "function",
		__schema = nil :: T,
		__schema_output = nil :: K,
		schema = input or schema.null,
		schema_output = output or schema.null,
		id = remote_tracker.take(),
	})
	remote_tracker.map(t.id, t)
	return t
end

return table.freeze({
	fn = fn :: Function,
	unreliable = unreliable :: Event,
	event = event :: Event,
})
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">trackers</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">connections</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.Parent.util.libtypes)
local logger = require(script.Parent.Parent.util.logger)

local connection_map: { [number]: { libtypes.Connection } } = {}
-- reliable events that arrived before anything connected, handed to the first connection like the engine's own queue
local held: { [number]: { n: number, dropped: boolean, [number]: unknown } } = {}
local MAX_HELD = 256

-- lists are swapped, never edited, so a dispatch that is mid-loop keeps the one it started with
local function add(id: number, cb: libtypes.Connection)
	local entry = table.clone(connection_map[id] or {})
	assert(not table.find(entry, cb), "FUNCTION ALREADY CONNECTED TO THIS EVENT")
	table.insert(entry, cb)
	connection_map[id] = entry

	local connected = true
	local queue = held[id]
	if queue then
		held[id] = nil
		-- deferred so the caller has its disconnect before the first one runs
		for i = 1, queue.n do
			task.defer(function()
				if connected then
					cb(queue[i])
				end
			end)
		end
	end

	local function remove()
		if not connected then
			return
		end
		connected = false
		local index = table.find(connection_map[id], cb)
		if index then
			local copy = table.clone(connection_map[id])
			table.remove(copy, index)
			-- nil, not {}, so the readers see no listeners
			connection_map[id] = if #copy > 0 then copy else nil
		end
	end

	return remove
end

local function get(id: number): { libtypes.Connection }?
	return connection_map[id]
end

local function hold(id: number, value: unknown)
	local queue = held[id]
	if not queue then
		queue = { n = 0, dropped = false }
		held[id] = queue
	end
	if queue.n == MAX_HELD then
		if not queue.dropped then
			queue.dropped = true
			logger.red(
				`EVENT #{id} GOT {MAX_HELD} MESSAGES BEFORE ANYTHING CONNECTED, LATER ONES ARE DROPPED UNTIL ONE DOES`
			)
		end
		return
	end
	queue.n += 1
	queue[queue.n] = value
end

return table.freeze({
	add = add,
	get = get,
	hold = hold,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ref-tracker</string>
          <string name="Source"><![CDATA[local current: { unknown }?

return table.freeze({
	set = function(refs: { unknown }?)
		current = refs
	end,
	get = function()
		return current
	end,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">remote-tracker</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.Parent.util.libtypes)
local remotes: { [number]: libtypes.Intermediate<any, any, any> } = {}

-- ids are handed out in order from 1, so the next one is always #remotes + 1
local function take(): number
	local id = #remotes + 1
	-- ids travel as a u8
	assert(id <= 255, "REMOTE LIMIT OF 255 REACHED")
	return id
end

local function map(key: number, remote: any)
	remotes[key] = remote
end

local function get()
	return remotes
end

return table.freeze({
	take = take,
	map = map,
	get = get,
})
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">util</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">callbacks</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.libtypes)
local logger = require(script.Parent.logger)
local callbacks: { [number]: libtypes.Callback } = {}

local function set(id: number, cb: libtypes.Callback)
	if callbacks[id] then
		logger.red(`CALLBACKS CAN ONLY BE SET ONCE! ID #{id}, THE FIRST ONE IS KEPT`)
		return
	end
	callbacks[id] = cb
end

local function get(id: number): libtypes.Callback?
	return callbacks[id]
end

return table.freeze({
	set = set,
	get = get,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">channel</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local constants = require(script.Parent.Parent.constants)
local dump = require(script.Parent.dump)
local libtypes = require(script.Parent.libtypes)
local logger = require(script.Parent.logger)
local writer = require(script.Parent.writer)

local message = writer.message

local SHRINK_FLOOR = 4096
local MAX_REFS = constants.MAX_REFS
local MAX_MESSAGES = constants.MAX_MESSAGES
local REF_BYTES = constants.REF_BYTES

-- channels written to since the last flush_all
local dirty: { libtypes.Channel } = {}
-- channels a flush left above SHRINK_FLOOR, dropped to it if they stay quiet until the next flush_all
local oversized: { libtypes.Channel } = {}

local function new(send: (buffer, { unknown }?) -> (), limit: number, reliable: boolean): libtypes.Channel
	return {
		inner = buffer.create(constants.LARGE_BUFFER_SIZE),
		cursor = 0,
		count = 0,
		references = {},
		send = send,
		limit = limit,
		reliable = reliable,
	}
end

local function flush(channel: libtypes.Channel)
	local used = channel.cursor
	if used == 0 then
		return
	end
	local b, refs = dump(channel)
	channel.cursor = 0
	channel.count = 0
	-- a send that throws (a cyclic table ref) loses this batch, not the channel
	local sent, why = pcall(channel.send :: any, b, refs)
	table.clear(channel.references)
	if not sent then
		logger.red(`DROPPED A {used}B BATCH, SENDING IT FAILED: {why}`)
	end

	-- one spike should not pin a huge buffer forever
	local size = buffer.len(channel.inner)
	if size > SHRINK_FLOOR then
		if used * 8 < size then
			channel.inner = buffer.create(size // 2)
		end
		oversized[#oversized + 1] = channel
	end
end

local function drop_refs_after(references: { unknown }, keep: number)
	for i = #references, keep + 1, -1 do
		references[i] = nil
	end
end

local function append(channel: libtypes.Channel, id: number, write: (any) -> (), data: any)
	local start, ref_start = channel.cursor, #channel.references
	-- a write that throws queues nothing, not even the refs it wrote before throwing
	local wrote, why = pcall(message :: any, channel, id, write, data)
	if not wrote then
		drop_refs_after(channel.references, ref_start)
		error(why, 0)
	end

	-- this message on its own, whatever is queued before it
	local bytes, refs = channel.cursor - start, #channel.references - ref_start
	local oversized = bytes + refs * REF_BYTES > channel.limit
	if refs > MAX_REFS or (oversized and not channel.reliable) then
		drop_refs_after(channel.references, ref_start)
		channel.cursor = start
		if refs > MAX_REFS then
			-- ref indices are one byte, past MAX_REFS they would point at the wrong refs
			error(`REMOTE #{id} WROTE {refs} REFS, ONE MESSAGE CAN CARRY {MAX_REFS}`)
		end
		-- the engine would drop it anyway
		logger.red(
			`DROPPED A {bytes}B UNRELIABLE MESSAGE WITH {refs} REFS FROM REMOTE #{id}, OVER THE {channel.limit}B LIMIT`
		)
		return
	end

	if start == 0 then
		dirty[#dirty + 1] = channel
	elseif
		channel.cursor + #channel.references * REF_BYTES > channel.limit
		or #channel.references > MAX_REFS
		or channel.count == MAX_MESSAGES
	then
		-- does not fit with what is queued: send that, then write this one again on its own
		drop_refs_after(channel.references, ref_start)
		channel.cursor = start
		flush(channel)

		message(channel, id, write, data)
	end
	channel.count += 1

	if oversized then
		logger.red(
			`REMOTE #{id} WROTE A {bytes}B MESSAGE WITH {refs} REFS, OVER THE {channel.limit}B LIMIT! IT WILL LIKELY BE DROPPED`
		)
	end
end

local function flush_all()
	for _, channel in oversized do
		if channel.cursor == 0 and buffer.len(channel.inner) > SHRINK_FLOOR then
			channel.inner = buffer.create(SHRINK_FLOOR)
		end
	end
	table.clear(oversized)
	for _, channel in dirty do
		flush(channel)
	end
	table.clear(dirty)
end

return table.freeze({
	new = new,
	append = append,
	-- sends what is queued now, for callers keeping order with another channel
	flush = flush,
	flush_all = flush_all,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">dump</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.libtypes)
return @native function(b: libtypes.Buffer): (buffer, { unknown }?)
	local cursor = b.cursor
	local dumpBuffer = buffer.create(cursor)
	buffer.copy(dumpBuffer, 0, b.inner, 0, cursor)
	return dumpBuffer, if #b.references > 0 then b.references else nil
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">iter-and-convert</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.libtypes)
local remote_names = require(script.Parent["remote-names"])
@native
local function iter_and_convert<T>(t: T & { [any]: any }, ctor: (libtypes.Intermediate<any, any, any>) -> any): (T, string)
	local result = {}
	-- "id path" for every remote, hashed below so the two sides can compare what they built
	local lines = {}

	local function recursive_index(origin: { [any]: any }, write_to: { [any]: any }, path: string)
		for i, v in pairs(origin) do
			local key = path .. tostring(i)
			if type(v) ~= "table" then
				error(`DEFINITIONS KEY {key} IS NOT A REMOTE OR A TABLE OF REMOTES`)
			end
			local is_schema = v.__kind and v.id

			if not is_schema then
				local new_table = {}
				write_to[i] = new_table
				recursive_index(v, new_table, key .. ".")
				continue
			end
			write_to[i] = ctor(v)
			table.insert(lines, `{v.id} {key}`)
		end
	end

	recursive_index(t, result, "")
	table.sort(lines)

	return table.freeze(result) :: any, remote_names.hash(table.concat(lines, "\n"))
end

return iter_and_convert
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">libtypes</string>
          <string name="Source"><![CDATA[-- types:

export type Buffer = {
	cursor: number,
	references: { unknown },
	inner: buffer,
}

export type Channel = Buffer & {
	send: (buffer, { unknown }?) -> (),
	limit: number,
	-- an unreliable channel drops a message over limit instead of sending it
	reliable: boolean,
	-- messages in the batch
	count: number,
}

export type function GetSchema(t: type, schemaindex: string)
	return t:readproperty(types.singleton(schemaindex))
end

-- a field's type is its schema's __T as is: nested structs already resolved theirs
export type function GetNestedSchema(t: type)
	local nt = types.newtable()
	for i, v in t:properties() do
		nt:setproperty(types.singleton(i:value()), GetSchema(v.read or types.never, "__T"))
	end
	return nt
end

export type Middleware = (id: number, plr: Player) -> boolean
export type Connection = (...any) -> ()
export type Callback = (...any) -> (boolean, ...any)
export type Cleanup = () -> ()

export type Schema<T = nil> = {
	read read: (buf: buffer, offset: number) -> (T, number),
	read write: (input: T) -> (),
	read __T: T,
}

export type Intermediate<T = nil, O = nil, K = never> = {
	read schema: Schema<T>,
	-- functions only
	read schema_output: Schema<O>?,
	read __schema_output: O,
	read __schema: T,
	read __kind: K,
	read id: number,
	-- events only
	read reliable: boolean?,
}

export type ClientRemote<T = nil> = {
	read connect: (self: any, callback: (T) -> ()) -> Cleanup,
	read fire: (any, T) -> (),
	read __T: T,
	read __kind: "event",
}
export type ClientFunction<T = nil, O = nil> = {
	read invoke: (any, T) -> (boolean, O?),
	read __T: T,
	read __O: O,
	read __kind: "function",
}
export type ServerRemote<T = nil> = {
	read connect: (self: any, callback: (Player, T) -> ()) -> Cleanup,
	read fire: (any, Player, T) -> (),
	read fire_all: (any, T) -> (),
	read __T: T,
	read __kind: "event",
}
export type ServerFunction<T = nil, O = nil> = {
	-- O? so a refusal can return false, nil as well as false
	read set_callback: (any, (Player, T) -> (boolean, ...O?)) -> (),
	read __T: T,
	read __O: O,
	read __kind: "function",
}

type function SearchAndReplace(input: type, relative_write_to: type, server: boolean): ()
	assert(input:is("table"), "NOT A TABLE")

	for i, v in input:properties() do
		local t = assert(v.read)

		local schema = GetSchema(t, "__schema")
		local schema_output = GetSchema(t, "__schema_output")
		if schema then -- is Intermediate
			local substituted: type
			do
				local remote_kind = t:readproperty(types.singleton("__kind"))
				assert(remote_kind, "FAILED TO GET KIND")
				remote_kind = remote_kind:value()
				if remote_kind == "function" then
					local output = schema_output or types.singleton(nil)
					substituted = if server then ServerFunction(schema, output) else ClientFunction(schema, output)
				elseif remote_kind == "event" then
					substituted = if server then ServerRemote(schema) else ClientRemote(schema)
				end
			end
			assert(substituted, "NO SUBSTITUTE")
			relative_write_to:setreadproperty(i, substituted)
		else
			local tempnt = types.newtable()
			relative_write_to:setreadproperty(i, tempnt)
			SearchAndReplace(t, tempnt, server)
		end
	end
end

export type function ReplicateClient(original: type)
	local ot = types.newtable()
	SearchAndReplace(original, ot, false)
	return ot
end

export type function ReplicateServer(original: type)
	local ot = types.newtable()
	SearchAndReplace(original, ot, true)
	return ot
end

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">logger</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local constants = require(script.Parent.Parent.constants)
local template = "[sendbufs]:"

-- read on every call so the attribute can be flipped on a live server
local function is_debug(): boolean
	return RunService:IsStudio() or workspace:GetAttribute(constants.IS_DEBUG_ATTRIBUTE) == true
end

-- for what any client can cause at will, so only shown in debug
local function orange(...: string)
	if not is_debug() then
		return
	end
	warn(template, ...)
end

-- for mistakes in the game's own code, always shown, without stopping the caller
local function red(...: string)
	task.spawn(error :: (string, number) -> (), table.concat({ template, ... }, " "), 0)
end

return table.freeze({
	orange = orange,
	red = red,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">read-server-remote-function</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local constants = require(script.Parent.Parent.constants)
local middleware = require(script.Parent.Parent.features.middleware)
local ref_tracker = require(script.Parent.Parent.trackers["ref-tracker"])
local remote_tracker = require(script.Parent.Parent.trackers["remote-tracker"])
local callbacks = require(script.Parent.callbacks)
local dump = require(script.Parent.dump)
local logger = require(script.Parent.logger)
local writer = require(script.Parent.writer)
local small_buffer = require(script.Parent["small-buffer"])

local remotes = remote_tracker.get()

return function(plr: Player, b: buffer, refs: { unknown }?): (boolean, buffer?, { unknown }?)
	local id = buffer.readu8(b, 0)
	local remo = remotes[id]

	if not remo or remo.__kind ~= "function" then
		logger.orange(`INVALID FUNCTION ID! #{id}`)
		return false, nil, nil
	end

	ref_tracker.set(refs)
	local read, value = pcall(remo.schema.read, b, 1)
	if not read then
		logger.orange(`MALFORMED PAYLOAD FOR FUNCTION #{id}: {value}`)
		return false, nil, nil
	end

	local callback = callbacks.get(id)

	if not callback then
		logger.orange(`UNHANDLED REMOTE FUNCTION! #{id}`)
		return false, nil, nil
	end

	if not middleware.run_middleware(id, plr) then
		return false, nil, nil
	end

	local ran, success, res = pcall(callback, plr, value)
	if not ran then
		logger.red(`CALLBACK FOR FUNCTION #{id} FAILED: {success}`)
		return false, nil, nil
	end
	if not success then
		return false, nil, nil
	end

	local out = small_buffer()
	writer.load(out)
	local wrote, why = pcall((remo.schema_output :: any).write, res)
	if not wrote then
		logger.red(`FUNCTION #{id} RETURNED A VALUE ITS SCHEMA CANNOT WRITE: {why}`)
		return false, nil, nil
	end
	writer.export()
	local count = #out.references
	if count > constants.MAX_REFS then
		-- ref indices are one byte, past MAX_REFS they would point at the wrong refs
		logger.red(`FUNCTION #{id} RETURNED {count} REFS, ONE REPLY CAN CARRY {constants.MAX_REFS}`)
		return false, nil, nil
	end
	return true, dump(out)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">read</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local constants = require(script.Parent.Parent.constants)
local middleware = require(script.Parent.Parent.features.middleware)
local connections = require(script.Parent.Parent.trackers.connections)
local ref_tracker = require(script.Parent.Parent.trackers["ref-tracker"])
local remote_tracker = require(script.Parent.Parent.trackers["remote-tracker"])
local logger = require(script.Parent.logger)

local remotes = remote_tracker.get()
local run_middleware = middleware.run_middleware
local get_listeners = connections.get
local hold = connections.hold
local set_refs = ref_tracker.set

local MAX_MESSAGES = constants.MAX_MESSAGES

-- one packet of events; plr is who sent it on the server, nil on the client
return function(b: buffer, refs: { unknown }?, plr: Player?)
	-- a bad packet from a client is its own doing, from the server it is the game's
	local log = if plr then logger.orange else logger.red
	local cursor, size = 0, buffer.len(b)
	-- ids whose middleware refused this packet, so a packet of copies runs it once
	local refused: { [number]: true }? = nil

	for _ = 1, MAX_MESSAGES do
		if cursor >= size then
			return
		end
		local id = buffer.readu8(b, cursor)
		local remo = remotes[id]
		if not remo or remo.__kind ~= "event" then
			log(`INVALID EVENT ID! #{id}`)
			return
		end

		-- set before every read: a middleware or listener that yields lets another packet set its own
		set_refs(refs)
		-- nothing past a bad message can be trusted, so the rest of the packet is dropped
		local read, value, nc = pcall(remo.schema.read, b, cursor + 1)
		if not read then
			log(`MALFORMED PAYLOAD FOR EVENT #{id}: {value}`)
			return
		end
		cursor += nc + 1

		local listeners = get_listeners(id)
		if plr then
			if listeners and not (refused and refused[id]) then
				if run_middleware(id, plr) then
					for _, v in listeners do
						task.spawn(v, plr, value)
					end
				else
					refused = refused or {}
					refused[id] = true
				end
			end
		elseif listeners then
			for _, v in listeners do
				task.spawn(v, value)
			end
		elseif remo.reliable then
			hold(id, value)
		end
	end

	if cursor < size then
		log(`PACKET CARRIED OVER {MAX_MESSAGES} MESSAGES, THE REST WAS DROPPED`)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">remote-names</string>
          <string name="Source"><![CDATA[-- names hashed from the JobId: both sides get the same ones without a handshake, and no two servers share them

local function fnv1a(text: string, hash: number): number
	for i = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, i))
		-- hash * 16777619, split so it stays inside a double
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return hash
end

local function guid(text: string): string
	local a = fnv1a(text, 2166136261)
	local b = fnv1a(text, a)
	local c = fnv1a(text, b)
	local d = fnv1a(text, c)
	return string.format("%08x-%04x-%04x-%04x-%04x%08x", a, b // 65536, b % 65536, c // 65536, c % 65536, d)
end

-- studio has no job, and its two sides spell that differently: the server reads "", the client this
local NO_JOB = "00000000-0000-0000-0000-000000000000"

local function names(job_id: string): (string, string, string)
	if job_id == NO_JOB then
		job_id = ""
	end
	return guid("reliable" .. job_id), guid("unreliable" .. job_id), guid("function" .. job_id)
end

return table.freeze({
	names = names,
	-- also hashes the definitions, so the client can check it built the same ids as the server
	hash = guid,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
