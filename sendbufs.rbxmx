<roblox version="4">
  <Item class="ModuleScript" referent="0">
    <Properties>
      <string name="Name">sendbufs</string>
      <string name="Source"><![CDATA[local middleware = require(script.features.middleware)
local schema = require(script.features.schema)
local libtypes = require(script.util.libtypes)
local client = require(script["init-modules"].client)
local server = require(script["init-modules"].server)
local shared = require(script["init-modules"].shared)

export type ClientEvent<T> = libtypes.ClientRemote<T>
export type ServerEvent<T> = libtypes.ServerRemote<T>

export type ClientFunction<T = nil, O = nil> = libtypes.ClientFunction<T, O>
export type ServerFunction<T = nil, O = nil> = libtypes.ServerFunction<T, O>

export type Middleware = libtypes.Middleware
export type Callback = libtypes.Callback
export type Schema<T> = libtypes.Schema<T>

return table.freeze({
	create_client = client,
	create_server = server,
	event = shared.event,
	unreliable = shared.unreliable,
	fn = shared.fn,
	middleware = middleware.middleware,
	schema = schema,
})
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">constants</string>
        <string name="Source"><![CDATA[return table.freeze({
	EVENT_FOLDER = game:GetService("ReplicatedStorage"),

	IS_DEBUG_ATTRIBUTE = "IS_DEBUG",
	-- set by the server on its reliable remote, checked by the client
	MAX_SIZE_ATTRIBUTE = "MAX_SIZE",
	SIGNATURE_ATTRIBUTE = "SIGNATURE",

	MAX_SERVER_BUFFER_SIZE = 4096,
	-- UnreliableRemoteEvent drops calls over 1000B, refs included, the rest is margin
	MAX_UNRELIABLE_SIZE = 900,
	-- what one ref is counted as against a batch's limit
	REF_BYTES = 8,
	-- ref indices are one byte
	MAX_REFS = 255,
	-- per inbound packet, so one packet can't spawn thousands of listener threads
	MAX_MESSAGES = 256,

	MIN_BUFFER_SIZE = 16,
	LARGE_BUFFER_SIZE = 256,
})
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">features</string>
