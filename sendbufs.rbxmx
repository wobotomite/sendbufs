          <string name="Name">instance-map</string>
        </Properties>
        <Item class="Script" referent="4">
          <Properties>
            <string name="Name">c</string>
            <token name="RunContext">2</token>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
    InstanceMap.client V0.1.1

    Initializes client instance map
]]
-----------------------------------------------------
-- DEPENDENCIES                                    --
-----------------------------------------------------
local constants = require(script.Parent.Parent.Parent.constants)
local instanceMap = require(script.Parent.shared)

-----------------------------------------------------
-- LOCALIZATIONS                                   --
-----------------------------------------------------
local DELAY: <A..., R...>(number?, ((A...) -> R...) | thread, A...) -> thread = task.delay
local SPAWN: <A..., R...>(((A...) -> R...) | thread, A...) -> thread = task.spawn
local RUNNING: () -> thread = coroutine.running
local YIELD: <A..., R...>(A...) -> R... = coroutine.yield

local ATTRIBUTE_NAME: string = constants.INSTANCE_ID_ATTRIBUTE

-----------------------------------------------------
-- MAIN                                            --
-----------------------------------------------------
local function retryGetAttribute(co: thread, instance: Instance): ()
	SPAWN(co, instance:GetAttribute(ATTRIBUTE_NAME))
end

local function deferFetch(instance: Instance): number?
	local co = RUNNING()
	DELAY(0, retryGetAttribute, co, instance)
	return YIELD()
end

local function onInstance(instance: Instance): ()
	local id: number? = (instance:GetAttribute(ATTRIBUTE_NAME) :: number?) or deferFetch(instance)
	if not id then
		return
	end
	instanceMap[id] = instance
end

game.DescendantAdded:Connect(onInstance)

for _, instance: Instance in game:GetDescendants() do
	onInstance(instance)
end
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="5">
          <Properties>
            <string name="Name">s</string>
            <token name="RunContext">1</token>
            <string name="Source"><![CDATA[--!strict
--!optimize 2
--[[
    InstanceMap.server V0.1.1

    Initializes server instance map
]]
-----------------------------------------------------
-- DEPENDENCIES                                    --
-----------------------------------------------------
local constants = require(script.Parent.Parent.Parent.constants)
const instanceMap = require(script.Parent.shared)

local mapped_services = {}
do
	const t = {}
	for i = 1, #constants.SERDES_WHITELIST do
		const service = game:GetService(constants.SERDES_WHITELIST[i])
		table.insert(t, service)
	end
	mapped_services = t
end

-----------------------------------------------------
-- LOCALIZATIONS                                   --
-----------------------------------------------------
const ATTRIBUTE_NAME: string = constants.INSTANCE_ID_ATTRIBUTE

-----------------------------------------------------
-- MAIN                                            --
-----------------------------------------------------
local i: number = 0

const function onInstance(instance: Instance): ()
	local no_ret = false
	for i, v in mapped_services do
		if instance:IsDescendantOf(v) then
			no_ret = true
			break
		end
	end

	if not no_ret then
		return
	end

	i += 1
	instance:SetAttribute(ATTRIBUTE_NAME, i)
	instanceMap[i] = instance
end

game.DescendantAdded:Connect(onInstance)

for _, instance: Instance in game:GetDescendants() do
	onInstance(instance)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">shared</string>
            <string name="Source"><![CDATA[return setmetatable({}, { __mode = "v" }) :: { [number]: Instance }
]]></string>
          </Properties>
        </Item>
      </Item>
