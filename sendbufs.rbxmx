<roblox version="4">
  <Item class="ModuleScript" referent="0">
    <Properties>
      <string name="Name">sendbufs</string>
      <string name="Source"><![CDATA[local middleware = require(script.features.middleware)
local schema = require(script.features.schema)
local client = require(script["init-modules"].client)
local server = require(script["init-modules"].server)
local shared = require(script["init-modules"].shared)

return table.freeze({
	create_client = client,
	create_server = server,
	event = shared.event,
	fn = shared.fn,
	middleware = middleware.middleware,
	schema = schema,
})
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">constants</string>
        <string name="Source"><![CDATA[return table.freeze({
	EVENT_TYPE = table.freeze({
		RELIABLE = 0,
		UNRELIABLE = 1,
	}),
	RELIABLE_EVENT_NAME = "_SB_RELIABLE",
	UNRELIABLE_EVENT_NAME = "_SB_UNRELIABLE",
	REMOTE_FUNCTION = "_SB_FUNCTION",

	EVENT_FOLDER = game:GetService("ReplicatedStorage"),

	-- INSTANCE_ID_ATTRIBUTE = "__SB_INSTANCE_ID",

	-- SERDES_WHITELIST = table.freeze({
	-- 	"Workspace",
	-- 	"ReplicatedStorage",
	-- }),

	MAX_SERVER_BUFFER_SIZE = 4096,

	MIN_BUFFER_SIZE = 16,
	LARGE_BUFFER_SIZE = 256,
})
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">features</string>
