      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">callbacks</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.libtypes)
local logger = require(script.Parent.logger)
local callbacks: { [number]: libtypes.Callback } = {}

local function set(id: number, cb: libtypes.Callback)
	if callbacks[id] then
		logger.orange(`CALLBACKS CAN ONLY BE SET ONCE! ID #{id}`)
		return
	end
	callbacks[id] = cb
end

local function get(id: number): libtypes.Callback?
	return callbacks[id]
end

return table.freeze({
	set = set,
	get = get,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">channel</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local constants = require(script.Parent.Parent.constants)
local dump = require(script.Parent.dump)
local libtypes = require(script.Parent.libtypes)
local logger = require(script.Parent.logger)
local writer = require(script.Parent.writer)

local load = writer.load
local u8 = writer.u8
local export = writer.export

local SHRINK_FLOOR = 4096
local MAX_REFS = 255

-- channels written to since the last flush_all
local dirty: { libtypes.Channel } = {}

local function new(send: (buffer, { unknown }?) -> (), limit: number): libtypes.Channel
	return {
		size = constants.LARGE_BUFFER_SIZE,
		inner = buffer.create(constants.LARGE_BUFFER_SIZE),
		cursor = 0,
		references = {},
		send = send,
		limit = limit,
	}
end

local function flush(channel: libtypes.Channel)
	local used = channel.cursor
	local b, refs = dump(channel)
	channel.cursor = 0
	channel.send(b, refs)
	table.clear(channel.references)

	-- one spike should not pin a huge buffer forever
	if channel.size > SHRINK_FLOOR and used * 8 < channel.size then
		channel.size //= 2
		channel.inner = buffer.create(channel.size)
	end
end

local function append(channel: libtypes.Channel, id: number, write: (any) -> (), data: any)
	local start, ref_start = channel.cursor, #channel.references
	load(channel)
	u8(id)
	write(data)
	export()

	local alone = start == 0
	if alone then
		dirty[#dirty + 1] = channel
	elseif channel.cursor > channel.limit or #channel.references > MAX_REFS then
		-- does not fit with what is queued: send that, then write this one again on its own
		local references = channel.references
		for i = #references, ref_start + 1, -1 do
			references[i] = nil
		end
		channel.cursor = start
		flush(channel)

		load(channel)
		u8(id)
		write(data)
		export()
		alone = true
	end

	if alone then
		if channel.cursor > channel.limit then
			logger.orange(
				`REMOTE #{id} WROTE {channel.cursor}B, OVER THE {channel.limit}B UNRELIABLE LIMIT! IT WILL BE DROPPED`
			)
		elseif #channel.references > MAX_REFS then
			logger.orange(`REMOTE #{id} WROTE {#channel.references} REFS, ONE PACKET CAN ONLY INDEX {MAX_REFS}`)
		end
	end
end

local function flush_all()
	for _, channel in dirty do
		if channel.cursor > 0 then
			flush(channel)
		end
	end
	table.clear(dirty)
end

return table.freeze({
	new = new,
	append = append,
	flush_all = flush_all,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">dump</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.libtypes)
return @native function(b: libtypes.Buffer): (buffer, { unknown }?)
	local cursor = b.cursor
	local dumpBuffer = buffer.create(cursor)
	buffer.copy(dumpBuffer, 0, b.inner, 0, cursor)
	return dumpBuffer, if #b.references > 0 then b.references else nil
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">iter-and-convert</string>
          <string name="Source"><![CDATA[local libtypes = require(script.Parent.libtypes)
@native
local function iter_and_convert<T>(t: T & { [any]: any }, ctor: (libtypes.Intermediate) -> any): T
	local result = {}

	local function recursive_index(origin: { [any]: any }, write_to: { [any]: any })
		for i, v in pairs(origin) do
			local is_schema = v.__kind and v.id

			if not is_schema then
				local new_table = {}
				write_to[i] = new_table
				recursive_index(v, new_table)
				continue
			end
			write_to[i] = ctor(v)
		end
	end

	recursive_index(t, result)

	return table.freeze(result)
end

return iter_and_convert
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">libtypes</string>
          <string name="Source"><![CDATA[-- types:

export type Buffer = {
	cursor: number,
	size: number,
	references: { unknown },
	inner: buffer,
}

export type Channel = Buffer & {
	send: (buffer, { unknown }?) -> (),
	limit: number,
}

export type function GetSchema(t: type, schemaindex: string)
	return t:readproperty(types.singleton(schemaindex))
end

export type function GetNestedSchema(t: type)
	local nt = types.newtable()
	local function traverse(t: type, n: type)
		for i, v in t:properties() do
			local tx = GetSchema(v.read or types.never, "__T")
			if tx:is("table") then
				local ntx = types.newtable()
				n:setproperty(types.singleton(i:value()), ntx)
				traverse(tx, ntx)
			else
				n:setproperty(types.singleton(i:value()), tx)
			end
		end
	end
	traverse(t, nt)

	return nt
end

export type Middleware = (id: number, plr: Player) -> boolean
export type Connection = (...any) -> ()
export type Callback = (...any) -> (boolean, any)
export type Cleanup = () -> ()

export type Schema<T = nil> = {
	read read: (buf: buffer, offset: number) -> (T, number),
	read write: (input: T) -> (),
	read __T: T,
}

export type Intermediate<T = nil, O = nil, K = never> = {
	read schema: Schema<T>,
	read schema_output: Schema<O>,
	read __schema_output: O,
	read __schema: T,
	read __kind: K,
	read id: number,
	read reliable: boolean,
}

export type ClientRemote<T = nil> = {
	read connect: (self: any, callback: (T) -> ()) -> Cleanup,
	read fire: (any, T) -> (),
	read __T: T,
	read __kind: "event",
}
export type ClientFunction<T = nil, O = nil> = {
	read invoke: (any, T) -> (boolean, O),
	read __T: T,
	read __O: O,
	read __kind: "function",
}
export type ServerRemote<T = nil> = {
	read connect: (self: any, callback: (Player, T) -> ()) -> Cleanup,
	read fire: (any, Player, T) -> (),
	read fire_all: (any, T) -> (),
	read __T: T,
	read __kind: "event",
}
export type ServerFunction<T = nil, O = nil> = {
	read set_callback: (any, (Player, T) -> (boolean, O)) -> (),
	read __T: T,
	read __O: O,
	read __kind: "function",
}

type function ClientSearchAndReplace(input: type, relative_write_to: type): ()
	assert(input:is("table"), "NOT A TABLE")

	for i, v in input:properties() do
		local t = assert(v.read)

		local schema = GetSchema(t, "__schema")
		local schema_output = GetSchema(t, "__schema_output")
		if schema then -- is Intermediate
			local substituted: type
			do
				local remote_kind = t:readproperty(types.singleton("__kind"))
				assert(remote_kind, "FAILED TO GET KIND")
				remote_kind = remote_kind:value()
				if remote_kind == "function" then
					substituted = ClientFunction(schema, schema_output or types.singleton(nil))
				elseif remote_kind == "event" then
					substituted = ClientRemote(schema)
				end
			end
			assert(substituted, "NO SUBSTITUTE")
			relative_write_to:setreadproperty(i, substituted)
		else
			local tempnt = types.newtable()
			relative_write_to:setreadproperty(i, tempnt)
			ClientSearchAndReplace(t, tempnt)
		end
	end
end

type function ServerSearchAndReplace(input: type, relative_write_to: type): ()
	assert(input:is("table"), "NOT A TABLE")

	for i, v in input:properties() do
		local t = assert(v.read)

		local schema = GetSchema(t, "__schema")
		local schema_output = GetSchema(t, "__schema_output")
		if schema then -- is Intermediate
			local substituted: type
			do
				local remote_kind = t:readproperty(types.singleton("__kind"))
				assert(remote_kind, "FAILED TO GET KIND")
				remote_kind = remote_kind:value()
				if remote_kind == "function" then
					substituted = ServerFunction(schema, schema_output or types.singleton(nil))
				elseif remote_kind == "event" then
					substituted = ServerRemote(schema)
				end
			end
			assert(substituted, "NO SUBSTITUTE")
			relative_write_to:setreadproperty(i, substituted)
		else
			local tempnt = types.newtable()
			relative_write_to:setreadproperty(i, tempnt)
			ServerSearchAndReplace(t, tempnt)
		end
	end
end

export type function ReplicateClient(original: type)
	local ot = types.newtable()
	ClientSearchAndReplace(original, ot)
	return ot
end

export type function ReplicateServer(original: type)
	local ot = types.newtable()
	ServerSearchAndReplace(original, ot)
	return ot
end

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">logger</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local constants = require(script.Parent.Parent.constants)
local is_debug = RunService:IsStudio() or (workspace:GetAttribute(constants.IS_DEBUG_ATTRIBUTE) == true)
local template = "[sendbufs]:"

local function white(...: string)
	if not is_debug then
		return
	end
	print(template, ...)
end

local function orange(...: string)
	if not is_debug then
		return
	end
	warn(template, ...)
end

local function errorif(cond: boolean, str: string)
	if cond then
		error(str)
	end
end

return table.freeze({
	errorif = errorif,
	white = white,
	orange = orange,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">read-client</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local connections = require(script.Parent.Parent.trackers.connections)
local remote_tracker = require(script.Parent.Parent.trackers["remote-tracker"])
local logger = require(script.Parent.logger)

local remotes = remote_tracker.get()
local get_listeners = connections.get

return function(b: buffer)
	local cursor, size = 0, buffer.len(b)
	while cursor < size do
		local id = buffer.readu8(b, cursor)
		local remo = remotes[id]
		if not remo or remo.__kind ~= "event" then
			logger.orange(`INVALID EVENT ID! #{id}`)
			return
		end

		local value, nc = remo.schema.read(b, cursor + 1)
		cursor += nc + 1

		local listeners = get_listeners(id)
		if listeners ~= nil then
			for _, v in listeners do
				task.spawn(v, value)
			end
		end
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">read-server-remote-function</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local middleware = require(script.Parent.Parent.features.middleware)
local remote_tracker = require(script.Parent.Parent.trackers["remote-tracker"])
local callbacks = require(script.Parent.callbacks)
local dump = require(script.Parent.dump)
local logger = require(script.Parent.logger)
local writer = require(script.Parent.writer)
local small_buffer = require(script.Parent["small-buffer"])

local remotes = remote_tracker.get()

return function(plr: Player, b: buffer): (boolean, buffer?, { unknown }?)
	local id = buffer.readu8(b, 0)
	local remo = remotes[id]

	if not remo or remo.__kind ~= "function" then
		logger.orange(`INVALID FUNCTION ID! #{id}`)
		return false, nil, nil
	end

	local read, value = pcall(remo.schema.read, b, 1)
	if not read then
		logger.orange(`MALFORMED PAYLOAD FOR FUNCTION #{id}: {value}`)
		return false, nil, nil
	end

	local callback = callbacks.get(id)

	if not callback then
		logger.orange(`UNHANDLED REMOTE FUNCTION! #{id}`)
		return false, nil, nil
	end

	if not middleware.run_middleware(id, plr) then
		return false, nil, nil
	end

	local ran, success, res = pcall(callback, plr, value)
	if not ran then
		logger.orange(`CALLBACK FAILED: {success}`)
		return false, nil, nil
	end
	if not success then
		return false, nil, nil
	end

	writer.load(small_buffer())
	local wrote, why = pcall(remo.schema_output.write :: any, res)
	if not wrote then
		logger.orange(`FUNCTION #{id} RETURNED A VALUE ITS SCHEMA CANNOT WRITE: {why}`)
		return false, nil, nil
	end
	return true, dump(writer.export())
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">read-server</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local middleware = require(script.Parent.Parent.features.middleware)
local connections = require(script.Parent.Parent.trackers.connections)
local remote_tracker = require(script.Parent.Parent.trackers["remote-tracker"])
local logger = require(script.Parent.logger)

local remotes = remote_tracker.get()
local run_middleware = middleware.run_middleware
local get_listeners = connections.get

-- the id being read, for the log line below
local reading = 0

local function read_packet(b: buffer, plr: Player)
	local cursor, size = 0, buffer.len(b)
	while cursor < size do
		local id = buffer.readu8(b, cursor)
		local remo = remotes[id]
		if not remo or remo.__kind ~= "event" then
			logger.orange(`INVALID EVENT ID! #{id}`)
			return
		end

		reading = id
		local value, nc = remo.schema.read(b, cursor + 1)
		cursor += nc + 1

		local listeners = get_listeners(id)
		if listeners ~= nil and run_middleware(id, plr) then
			for _, v in listeners do
				task.spawn(v, plr, value)
			end
		end
	end
end

-- one pcall a packet: nothing past a bad message can be trusted, so the rest of it is dropped
return function(b: buffer, plr: Player)
	local read, why = pcall(read_packet :: any, b, plr)
	if not read then
		logger.orange(`MALFORMED PAYLOAD FOR EVENT #{reading}: {why}`)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">remote-names</string>
          <string name="Source"><![CDATA[-- names hashed from the JobId: both sides get the same ones without a handshake, and no two servers share them

local function fnv1a(text: string, hash: number): number
	for i = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, i))
		-- hash * 16777619, split so it stays inside a double
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return hash
end

local function guid(text: string): string
	local a = fnv1a(text, 2166136261)
	local b = fnv1a(text, a)
	local c = fnv1a(text, b)
	local d = fnv1a(text, c)
	return string.format("%08x-%04x-%04x-%04x-%04x%08x", a, b // 65536, b % 65536, c // 65536, c % 65536, d)
end

return function(job_id: string): (string, string, string)
	return guid("reliable" .. job_id), guid("unreliable" .. job_id), guid("function" .. job_id)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">small-buffer</string>
          <string name="Source"><![CDATA[local constants = require(script.Parent.Parent.constants)

local libtypes = require(script.Parent.libtypes)
return @native function(): libtypes.Buffer
	return {
		size = constants.MIN_BUFFER_SIZE,
		inner = buffer.create(constants.MIN_BUFFER_SIZE),
		cursor = 0,
		references = {},
	}
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">writer</string>
          <string name="Source"><![CDATA[--!native
--!optimize 2
local constants = require(script.Parent.Parent.constants)
local libtypes = require(script.Parent.libtypes)

local current: libtypes.Buffer

local size: number
local cursor: number
local inner: buffer
local references: { [number]: unknown }

local function grow(bytes: number)
	local needed = cursor + bytes
	repeat
		size *= 2
	until size >= needed

	local newBuffer = buffer.create(size)
	buffer.copy(newBuffer, 0, inner, 0, cursor)

	inner = newBuffer
end

local bufferWriter = {}

function bufferWriter.alloc(bytes: number)
	if cursor + bytes > size then
		grow(bytes)
	end
end

function bufferWriter.u8(value: number)
	if cursor + 1 > size then
		grow(1)
	end
	buffer.writeu8(inner, cursor, value)
	cursor += 1
end

function bufferWriter.i8(value: number)
	if cursor + 1 > size then
		grow(1)
	end
	buffer.writei8(inner, cursor, value)
	cursor += 1
end

function bufferWriter.reference(value: any)
	if cursor + 1 > size then
		grow(1)
	end
	if value == nil then
		value = constants.VOID
	end
	local index = #references + 1
	references[index] = value
	buffer.writeu8(inner, cursor, index)
	cursor += 1
end

function bufferWriter.u16(value: number)
	if cursor + 2 > size then
		grow(2)
	end
	buffer.writeu16(inner, cursor, value)
	cursor += 2
end

function bufferWriter.i16(value: number)
	if cursor + 2 > size then
		grow(2)
	end
	buffer.writei16(inner, cursor, value)
	cursor += 2
end

function bufferWriter.u32(value: number)
	if cursor + 4 > size then
		grow(4)
	end
	buffer.writeu32(inner, cursor, value)
	cursor += 4
end

-- LEB128: 7 bits per byte, so lengths under 128 cost one byte
function bufferWriter.varint(value: number)
	if cursor + 8 > size then
		grow(8)
	end
	while value >= 128 do
		buffer.writeu8(inner, cursor, value % 128 + 128)
		cursor += 1
		value //= 128
	end
	buffer.writeu8(inner, cursor, value)
	cursor += 1
end

function bufferWriter.writestring(value: string)
	local len = #value
	if cursor + len > size then
		grow(len)
	end
	buffer.writestring(inner, cursor, value)
	cursor += len
end

function bufferWriter.i32(value: number)
	if cursor + 4 > size then
		grow(4)
	end
	buffer.writei32(inner, cursor, value)
	cursor += 4
end

function bufferWriter.f32NoAlloc(value: number)
	buffer.writef32(inner, cursor, value)
	cursor += 4
end

function bufferWriter.f64NoAlloc(value: number)
	buffer.writef64(inner, cursor, value)
	cursor += 8
end

function bufferWriter.f32(value: number)
	if cursor + 4 > size then
		grow(4)
	end
	buffer.writef32(inner, cursor, value)
	cursor += 4
end

function bufferWriter.f64(value: number)
	if cursor + 8 > size then
		grow(8)
	end
	buffer.writef64(inner, cursor, value)
	cursor += 8
end

function bufferWriter.copy(value)
	buffer.copy(inner, cursor, value)
	cursor += buffer.len(value)
end

function bufferWriter.bool(val: boolean)
	if cursor + 1 > size then
		grow(1)
	end
	buffer.writeu8(inner, cursor, if val then 1 else 0)
	cursor += 1
end

function bufferWriter.load(channel: libtypes.Buffer)
	current = channel
	size = channel.size
	cursor = channel.cursor
	references = channel.references
	inner = channel.inner
end

function bufferWriter.export()
	current.size = size
	current.cursor = cursor
	current.references = references
	current.inner = inner

	return current
end

return bufferWriter
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>